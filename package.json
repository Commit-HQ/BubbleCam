{
	"name": "bubblecam",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "wrangler dev --port 4173",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p src/service-worker",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"test": "vitest run",
		"deploy": "npm run build && wrangler deploy",
		"validate": "npm run check && npm run lint && npm run test && npm run build",
		"version": "vitest run src/changelog.test.ts"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"engines": {
		"node": ">=24 <25"
	},
	"devDependencies": {
		"@fontsource-variable/fredoka": "^5.3.0",
		"@fontsource-variable/hanken-grotesk": "^5.3.0",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^24.19.2",
		"fake-indexeddb": "^6.2.7",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.3.5",
		"vitest": "^5.0.5",
		"wrangler": "^4.156.1"
	},
	"dependencies": {
		"mediabunny": "^1.65.0"
	}
}
