# Headers for every page and file, which Cloudflare serves as static assets without running any code (wrangler.jsonc).
# The rest of the Content-Security-Policy is a <meta> tag that SvelteKit generates with each page's hashes, and a
# <meta> policy can't set frame-ancestors.
/*
  Content-Security-Policy: frame-ancestors 'none'
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: camera=(self), microphone=(), geolocation=(), display-capture=()
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff

# Files whose names change with their content can be kept for good.
/_app/immutable/*
  Cache-Control: public, max-age=31536000, immutable
