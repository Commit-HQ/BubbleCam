# Copy to `.env` and set before running or building. Values are read at build time.

# Public origin of the site: https:// and a hostname, optionally with a port, and nothing after it (http:// is
# accepted for localhost). Canonical URLs and link previews are written into the prerendered HTML, so set this
# where you build.
PUBLIC_SITE_URL=https://bubblecam.example.com
